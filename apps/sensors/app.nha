{"kind":"readout","manifest":{"author":"wenzi7777","category":"diagnostics","icon":"wave","id":"sensors","min_os":"v1.6.0","name":"Sensor Scope","summary":"Live IMU, magnetometer and battery readings, charted.","version":"1.0.0"},"nhapp":1,"readout":{"refresh_ms":500,"sections":[{"kind":"chart","points":120,"series":[{"field":"ax","label":"x"},{"field":"ay","label":"y"},{"field":"az","label":"z"}],"source":"imu","title":"Acceleration (g)"},{"kind":"chart","points":120,"series":[{"field":"gx","label":"x"},{"field":"gy","label":"y"},{"field":"gz","label":"z"}],"source":"imu","title":"Rotation (deg/s)"},{"kind":"chart","points":120,"series":[{"field":"mx","label":"x"},{"field":"my","label":"y"},{"field":"mz","label":"z"}],"source":"mag","title":"Magnetic field (uT)"},{"items":[{"field":"valid","format":"bool","hint":"False on a board without an IMU, or while it is disabled.","label":"IMU","source":"imu"},{"field":"valid","format":"bool","hint":"False on a board without one, or before its calibration is loaded.","label":"Magnetometer","source":"mag"},{"field":"percent","format":"raw","hint":"State of charge from the fuel gauge, in percent.","label":"Battery","source":"battery"},{"field":"mv","format":"int","hint":"Millivolts.","label":"Battery voltage","source":"battery"}],"kind":"stats","title":"Now"}],"sources":[{"command":"sensor_sample","id":"imu","path":"imu"},{"command":"sensor_sample","id":"mag","path":"mag"},{"command":"sensor_sample","id":"battery","path":"battery"}]}}
