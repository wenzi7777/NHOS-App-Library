{"kind":"readout","manifest":{"author":"wenzi7777","category":"diagnostics","icon":"activity","id":"sysmon","min_os":"v1.2.0","name":"System Monitor","summary":"Live scheduler, service and app activity for a device.","version":"1.0.0"},"nhapp":1,"readout":{"refresh_ms":1000,"sections":[{"items":[{"field":"busy_permille","format":"permille","hint":"Share of wall time spent dispatching tasks. A tick that performs a scan legitimately consumes most of a frame, so a high figure here is normal.","label":"Scheduler load","source":"sched"},{"field":"actual_scan_fps","format":"int","hint":"Frames actually completed per second.","label":"Scan rate","source":"scan"},{"field":"overrun_frames","format":"int","hint":"Cumulative frames that ran late. This, not scheduler load, is the authority on whether sampling is keeping up.","label":"Missed deadlines","source":"scan"},{"field":"last_scan_duration_us","format":"micros","label":"Scan time","source":"scan"},{"field":"budget_us","format":"micros","hint":"What all apps together may spend per dispatch. Shrinks automatically if the scan starts missing deadlines.","label":"Apps allowance","source":"appmeta"},{"field":"last_total_us","format":"micros","label":"Apps used","source":"appmeta"},{"field":"heap_free","format":"bytes","label":"Heap free","source":"mem"},{"field":"heap_largest_free_block","format":"bytes","hint":"Fragmentation. A large free heap made of small pieces will still fail a big allocation, such as the ones WiFi makes.","label":"Largest free block","source":"mem"},{"field":"heap_min_free","format":"bytes","hint":"The least free heap seen since boot.","label":"Heap low-water","source":"mem"}],"kind":"stats","title":"Overview"},{"columns":[{"field":"name","format":"text","label":"Task"},{"bar":true,"bar_max":1000,"field":"cpu_permille","format":"permille","label":"CPU"},{"field":"last_us","format":"micros","label":"Last"},{"field":"max_us","format":"micros","label":"Peak"},{"field":"invocations","format":"int","label":"Calls"},{"field":"enabled","format":"bool","label":"Enabled"}],"kind":"table","sort":{"desc":true,"field":"cpu_permille"},"source":"tasks","title":"Tasks"},{"columns":[{"field":"name","format":"text","label":"Slot"},{"field":"state","format":"text","label":"State"},{"field":"budget_us","format":"micros","label":"Allowance"},{"field":"last_us","format":"micros","label":"Last"},{"field":"max_us","format":"micros","label":"Peak"},{"field":"overruns","format":"int","label":"Overruns"},{"field":"events","format":"int","label":"Events"}],"kind":"table","sort":{"desc":true,"field":"last_us"},"source":"apps","title":"Apps"},{"columns":[{"field":"name","format":"text","label":"Service"},{"field":"state","format":"text","label":"State"},{"field":"restarts","format":"int","label":"Restarts"},{"field":"health_failures","format":"int","label":"Health failures"}],"kind":"table","source":"svcs","title":"Services"}],"sources":[{"command":"task_list","id":"sched"},{"command":"task_list","id":"tasks","path":"tasks"},{"command":"service_list","id":"svcs","path":"services"},{"command":"app_list","id":"apps","path":"apps"},{"command":"app_list","id":"appmeta"},{"command":"memory_status","id":"mem"},{"command":"scan_health","id":"scan"}]}}
