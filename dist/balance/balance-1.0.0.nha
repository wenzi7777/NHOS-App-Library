{"kind":"rules","manifest":{"author":"wenzi7777","capabilities":["emit_event","read_matrix"],"category":"biomechanics","icon":"scale","id":"balance","min_os":"v1.1.0","name":"Left/Right Balance","summary":"Normalised left-right load difference, -1 to +1.","version":"1.0.0"},"name":"balance","nhapp":1,"nodes":[{"c0":0,"c1":6,"op":"region_sum","r0":0,"r1":14},{"c0":8,"c1":14,"op":"region_sum","r0":0,"r1":14},{"in":[0,1],"op":"sub"},{"in":[0,1],"op":"add"},{"in":[2,3],"op":"div"},{"in":4,"op":"mean","window":30},{"hysteresis":0.05,"in":5,"op":"threshold","value":0.25},{"in":6,"ms":250,"op":"debounce"},{"event":"lean_left","in":7,"op":"emit"}]}
