{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wenzi7777/NHOS-App-Library/schema/readout.schema.json",
  "title": "NHOS readout package (.nha, kind: readout)",
  "description": "Reads out what the instrument measured. Declarative on purpose: it names device commands to read and widgets to draw, and carries no code, so installing one cannot execute anything in the operator's browser. It is installed on the DEVICE like any other package -- so what a device has travels with it -- but occupies only a registry entry: no slot, no budget, no dispatch.",
  "type": "object",
  "required": ["nhapp", "kind", "manifest", "readout"],
  "properties": {
    "nhapp": {"const": 1},
    "kind": {"const": "readout"},
    "manifest": {"$ref": "package.schema.json#/$defs/manifest"},
    "readout": {
      "type": "object",
      "required": ["sources", "sections"],
      "properties": {
        "refresh_ms": {"type": "integer", "minimum": 500, "maximum": 60000, "default": 1000},
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["id", "command"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "command": {"type": "string", "description": "A read-only device command."},
              "path": {"type": "string", "description": "Field inside the result's data to take, for list sources."}
            }
          }
        },
        "sections": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["kind", "title"],
            "properties": {
              "kind": {"enum": ["stats", "table", "chart"]},
              "title": {"type": "string", "maxLength": 40},
              "source": {"type": "string"},
              "sort": {
                "type": "object",
                "properties": {"field": {"type": "string"}, "desc": {"type": "boolean"}}
              },
              "items": {
                "type": "array", "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": ["label", "source", "field"],
                  "properties": {
                    "label": {"type": "string", "maxLength": 24},
                    "source": {"type": "string"},
                    "field": {"type": "string"},
                    "format": {"type": "string"},
                    "hint": {"type": "string", "maxLength": 120}
                  }
                }
              },
              "series": {
                "type": "array", "minItems": 1, "maxItems": 4,
                "description": "chart only: numeric fields of `source` plotted over the last `points` polls.",
                "items": {
                  "type": "object",
                  "required": ["field"],
                  "properties": {
                    "label": {"type": "string", "maxLength": 20},
                    "field": {"type": "string"}
                  }
                }
              },
              "points": {"type": "integer", "minimum": 10, "maximum": 600, "default": 60, "description": "chart only: how many polls of history to keep."},
              "min": {"type": "number", "description": "chart only: fixed bottom of the y axis; otherwise it follows the data."},
              "max": {"type": "number", "description": "chart only: fixed top of the y axis."},
              "columns": {
                "type": "array", "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["label", "field"],
                  "properties": {
                    "label": {"type": "string", "maxLength": 20},
                    "field": {"type": "string"},
                    "format": {"type": "string"},
                    "bar": {"type": "boolean", "description": "Draw a proportional bar beside the value."},
                    "bar_max": {"type": "number"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
